---
// The 1280 x 640 link-preview card, drawn from PROFILE.md. public/social.png is a screenshot of this page; the README
// says how to refresh it after the slogan changes. Not linked, not in the sitemap or the search index.
// The slogan leads with the first word of each line in bold, the focus labels sit under it, and the name and the handle
// sign the foot. It carries no job title, so the card does not date.
// The layout is the LinkedIn banner's, scaled by 1.1 and centred: the lamp hangs beside the slogan, the slogan is the
// largest text, and the labels, the rule and the foot are evenly spaced.
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';
import { identity, sloganLines } from '../lib/site';

const slogan = sloganLines.map((line) => {
  const [key, ...rest] = line.split(' ');
  return { key, rest: rest.join(' ') };
});
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <title>{identity.handle} card</title>
  </head>
  <body>
    <div class="card">
      <svg class="lamp" viewBox="0 0 88 292" aria-hidden="true">
        <rect x="39" y="0" width="10" height="215" fill="#cbd5e1" />
        <rect x="31" y="208" width="26" height="19" rx="4" fill="#cbd5e1" />
        <circle cx="44" cy="259" r="33" fill="#fbbf24" />
      </svg>
      <div class="slogan">{slogan.map(({ key, rest }) => <div><b>{key}</b>{` ${rest}`}</div>)}</div>
      <div class="focus">
        {identity.focus.map((f, i) => <>{i > 0 && <span class="sep">·</span>}<span>{f}</span></>)}
      </div>
      <div class="rule"></div>
      <div class="foot">
        <div class="name">{identity.name}</div>
        <div class="handle">{identity.handle}</div>
      </div>
    </div>
  </body>
</html>

<style is:global>
  html,
  body {
    margin: 0;
    background: #0f172a;
  }
  .card {
    position: relative;
    width: 1280px;
    height: 640px;
    overflow: hidden;
    background:
      radial-gradient(circle at 134px 259px, rgb(251 191 36 / 22%), transparent 330px),
      linear-gradient(135deg, #1e2230 0%, #0f172a 70%);
    color: #f8fafc;
    font-family: 'Inter Variable', sans-serif;
  }
  .lamp {
    position: absolute;
    left: 90px;
    top: 0;
    width: 88px;
    height: 292px;
  }
  /* Bold keeps the emphasis in one colour family; the bulb hangs level with the last two lines. */
  .slogan {
    position: absolute;
    left: 231px;
    top: 140px;
    font-size: 60px;
    font-weight: 400;
    line-height: 1.1;
    letter-spacing: -0.01em;
    color: #cbd5e1;
  }
  .slogan b {
    font-weight: 800;
    color: #f8fafc;
  }
  .focus {
    position: absolute;
    left: 233px;
    top: 358px;
    display: flex;
    gap: 12px;
    font-size: 27px;
    color: #cbd5e1;
  }
  .focus .sep {
    color: #475569;
  }
  .rule {
    position: absolute;
    left: 233px;
    right: 90px;
    top: 411px;
    height: 1px;
    background: #334155;
  }
  .foot {
    position: absolute;
    left: 233px;
    right: 90px;
    top: 433px;
    display: flex;
    justify-content: space-between;
    align-items: baseline;
  }
  .name {
    font-size: 31px;
    color: #cbd5e1;
  }
  .handle {
    font: 700 51px/1 'JetBrains Mono Variable', monospace;
    letter-spacing: -0.02em;
  }
</style>
