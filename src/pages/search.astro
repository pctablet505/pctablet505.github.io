---
import Base from '../layouts/Base.astro';
---
<Base title="Search" description="Search every page of the site.">
  <header class="wrap entry-head">
    <p class="eyebrow">Search</p>
    <h1>Search the site</h1>
  </header>
  <section class="wrap narrow" style="padding-bottom:4rem" data-pagefind-ignore>
    <link href="/pagefind/pagefind-ui.css" rel="stylesheet" />
    <div id="search"></div>
    <noscript><p>Search needs JavaScript. Every page is also listed on <a class="text-link" href="/work/">Work</a>.</p></noscript>
    <script is:inline src="/pagefind/pagefind-ui.js"></script>
    <script is:inline>
      window.addEventListener('DOMContentLoaded', function () {
        if (window.PagefindUI) {
          new PagefindUI({ element: '#search', showSubResults: true, autofocus: true });
        } else {
          document.getElementById('search').textContent = 'Search is built with the site; it is not available in this preview.';
        }
      });
    </script>
  </section>
</Base>

<style is:global>
  #search {
    --pagefind-ui-primary: var(--accent);
    --pagefind-ui-text: var(--ink);
    --pagefind-ui-background: var(--surface);
    --pagefind-ui-border: var(--line-2);
    --pagefind-ui-tag: var(--surface-2);
    --pagefind-ui-font: var(--font-sans);
  }
</style>
