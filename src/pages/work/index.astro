---
import Base from '../../layouts/Base.astro';
import WorkCard from '../../components/WorkCard.astro';
import EntryRow from '../../components/EntryRow.astro';
import { AREA_META, AREA_ORDER, workIn } from '../../lib/site';
---
<Base title="Work" description="Projects in computer vision, sensor ML, performance and inference, and independent research: case studies first.">
  <header class="wrap entry-head">
    <p class="eyebrow">Work</p>
    <h1>Every project, by area</h1>
    <p class="lede">
      The strongest work sits at the top of each area as cards; everything else is one line below it. Some cards open
      into a full case study: problem, approach, results.
    </p>
    <ul class="chips">
      {AREA_ORDER.map((a) => (
        <li><a class="chip" data-area={a} href={`#${a}`} style="text-decoration:none"><span class="dot" />{AREA_META[a].label}</a></li>
      ))}
    </ul>
  </header>
  {AREA_ORDER.map((a) => {
    const es = workIn(a);
    const top = es.filter((e) => e.priority < 3);
    const rest = es.filter((e) => e.priority === 3);
    return (
      <section class="section" id={a} data-area={a}>
        <div class="wrap">
          <div class="section-head">
            <div>
              <h2>{AREA_META[a].label}</h2>
              <p>{AREA_META[a].blurb}</p>
            </div>
          </div>
          <div class="grid two">
            {top.map((e) => <WorkCard entry={e} feature={e.priority === 1} />)}
          </div>
          {rest.length > 0 && (
            <div style="margin-top:2rem">
              <h3 style="margin-bottom:.75rem">Also in {AREA_META[a].label.toLowerCase()}</h3>
              <ul class="list">{rest.map((e) => <EntryRow entry={e} />)}</ul>
            </div>
          )}
        </div>
      </section>
    );
  })}
</Base>
