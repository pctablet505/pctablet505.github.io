---
import Base from '../layouts/Base.astro';
import Stat from '../components/Stat.astro';
import EntryRow from '../components/EntryRow.astro';
import { md } from '../lib/md';
import { byPriority, profile, section, work } from '../lib/site';

const oss = profile.byId.get('oss-summary');
const others = byPriority(section('Open source').filter((e) => e.id !== 'oss-summary'));
const upstream = byPriority(work().filter((e) => e.status === 'merged'));
const proposed = byPriority(work().filter((e) => e.status === 'proposed'));
const allPrs = oss?.numbers.find((n) => n.id === 'merged')?.source;
---
<Base title="Open source" description="Merged pull requests in Keras, KerasHub and Python and ML tooling, counted live from GitHub and dated.">
  <header class="wrap entry-head">
    <p class="eyebrow">Open source</p>
    <h1>Merged upstream</h1>
    {oss?.summary && <p class="lede">{oss.summary}</p>}
  </header>
  <section class="wrap" style="padding-bottom:2rem">
    {oss && <div class="numbers">{oss.numbers.map((n) => <Stat num={n} />)}</div>}
    {allPrs && <p style="margin-top:1rem"><a class="text-link" href={allPrs}>Every merged pull request, live on GitHub ↗</a></p>}
  </section>
  <section class="section">
    <div class="wrap">
      <div class="section-head"><div><h2>Keras and KerasHub</h2><p>The larger pieces, each with its own page.</p></div></div>
      <ul class="list">{upstream.map((e) => <EntryRow entry={e} />)}</ul>
    </div>
  </section>
  <section class="section">
    <div class="wrap">
      <div class="section-head"><div><h2>Elsewhere</h2></div></div>
      {others.map((e) => (
        <article id={e.id} style="margin-bottom:2rem">
          <h3>{e.title}</h3>
          <div class="prose" style="margin:.4rem 0 .6rem"><Fragment set:html={md(e.summary)} /></div>
          <ul class="chips">{e.links.map((l) => <li><a class="chip" href={l.url} style="text-decoration:none">{l.label} ↗</a></li>)}</ul>
        </article>
      ))}
    </div>
  </section>
  {proposed.length > 0 && (
    <section class="section">
      <div class="wrap">
        <div class="section-head"><div><h2>Built and proposed, not merged</h2><p>Larger designs that went upstream as proposals and were not merged.</p></div></div>
        <ul class="list">{proposed.map((e) => <EntryRow entry={e} />)}</ul>
      </div>
    </section>
  )}
</Base>
