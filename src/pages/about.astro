---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import sketch from '../assets/sketch.jpg';
import { md, mdInline } from '../lib/md';
import { imageFor } from '../lib/images';
import type { Entry } from '../lib/profile';
import { byDate, entryHref, identity, linksAt, profile, section } from '../lib/site';

const photo = identity.photo ? imageFor(identity.photo) : sketch;
// The About text in PROFILE.md: an opening line, which is the page title, then ### sections. A section's #### parts
// show as cards.
const [opening, ...parts] = profile.about.split(/^### /m);
const [title, ...intro] = opening.trim().split(/\n\s*\n/);
const slug = (s: string) => s.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
const sections = parts.map((part) => {
  const [heading, ...lines] = part.split('\n');
  const [text, ...cards] = lines.join('\n').split(/^#### /m);
  return {
    heading: heading.trim(),
    text: text.trim(),
    cards: cards.map((c) => {
      const [h, ...body] = c.split('\n');
      return { heading: h.trim(), body: body.join('\n').trim() };
    }),
  };
});
// The path: the main jobs, then the degrees, newest first, in years. Every role in full is on the Experience page.
const path = [...byDate(section('Experience')).filter((e) => e.priority <= 2), ...byDate(section('Education'))];
const year = (d?: string) => (d === 'present' ? 'now' : (d ?? '').slice(0, 4));
const years = (e: Entry) => {
  const [from, to] = [year(e.start ?? e.date), year(e.end)];
  return to && to !== from ? `${from} – ${to}` : from;
};
// LinkedIn leads, as on the home page; email and the other main links follow.
const linkedin = identity.links.find((l) => l.url.includes('linkedin.com'));
const contacts = [
  ...(linkedin ? [{ label: linkedin.label, href: linkedin.url }] : []),
  ...(identity.email ? [{ label: 'Email', href: `mailto:${identity.email}` }] : []),
  ...linksAt(1).filter((l) => l !== linkedin).map((l) => ({ label: l.label, href: l.url })),
];
const elsewhere = linksAt(2);
---
<Base title="About" description={`About ${identity.name}: what I work on, how I work, and the path so far.`}>
  <header class="wrap about-head">
    <div>
      <p class="eyebrow">About</p>
      <h1 set:html={mdInline(title)} />
      {intro.length > 0 && <div class="lede" set:html={md(intro.join('\n\n'))} />}
      <ul class="chips">
        <li class="chip">Machine learning engineer</li>
        <li class="chip">{identity.location}</li>
        {identity.languages.length > 0 && <li class="chip">{identity.languages.join(' and ')}</li>}
      </ul>
    </div>
    {photo && <Image class="about-photo" src={photo} alt={`A sketch of ${identity.name}`} width={480} />}
  </header>

  {sections.map((s) => (
    <section class="section" id={slug(s.heading)}>
      <div class="wrap">
        <div class="section-head"><h2>{s.heading}</h2></div>
        {s.text && <div class="prose about-text" set:html={md(s.text)} />}
        {s.cards.length > 0 && (
          <div class="about-cards">
            {s.cards.map((c) => (
              <article class="about-card">
                <h3>{c.heading}</h3>
                <div class="prose" set:html={md(c.body)} />
              </article>
            ))}
          </div>
        )}
      </div>
    </section>
  ))}

  <section class="section" id="path">
    <div class="wrap">
      <div class="section-head">
        <h2>The path so far</h2>
        <a class="text-link" href="/experience/">Each role in full →</a>
      </div>
      <ol class="timeline about-path">
        {path.map((e) => (
          <li>
            <div class="when">{years(e)}</div>
            <a href={entryHref(e)}>{e.title}</a>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section" id="contact">
    <div class="wrap">
      <div class="section-head"><h2>Get in touch</h2></div>
      <p class="lede">LinkedIn is the quickest way to reach me. Email works too.</p>
      <div class="btn-row">
        {contacts.map((c, i) => <a class={i === 0 ? 'btn primary' : 'btn'} href={c.href}>{c.label}</a>)}
      </div>
      {elsewhere.length > 0 && (
        <p class="about-elsewhere">
          Also on {elsewhere.map((l, i) => <>{i > 0 && (i === elsewhere.length - 1 ? ' and ' : ', ')}<a class="text-link" href={l.url}>{l.label}</a></>)}.
        </p>
      )}
    </div>
  </section>
</Base>
