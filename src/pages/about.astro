---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import sketch from '../assets/sketch.jpg';
import { md } from '../lib/md';
import { imageFor } from '../lib/images';
import { byDate, identity, linksAt, profile, section } from '../lib/site';

const photo = identity.photo ? imageFor(identity.photo) : sketch;
const now = byDate(section('Experience'))[0];
const education = section('Education');
---
<Base title="About" description={`About ${identity.name}, who publishes as ${identity.handle}: ${identity.headline.toLowerCase()}.`}>
  <header class="wrap entry-head">
    <p class="eyebrow">About</p>
    <h1>{identity.name}, who publishes as {identity.handle}</h1>
  </header>
  <div class="wrap entry-body">
    <div class="prose"><Fragment set:html={md(profile.about)} /></div>
    <aside class="entry-aside">
      {photo && <Image src={photo} alt={identity.name} width={480} style="width:100%;height:auto;border-radius:16px;border:1px solid var(--line)" />}
      <div>
        <h2>At a glance</h2>
        <ul>
          {now && <li>{now.title_field}, {now.org}</li>}
          <li>{identity.location}</li>
          {identity.languages.length > 0 && <li>Speaks {identity.languages.join(' and ')}</li>}
          {education.map((e) => <li><a href={`/certificates/#${e.id}`}>{e.title}</a></li>)}
        </ul>
      </div>
      <div>
        <h2>Reach me</h2>
        <ul>
          {identity.email && <li><a href={`mailto:${identity.email}`}>{identity.email}</a></li>}
          {[...linksAt(1), ...linksAt(2)].map((l) => <li><a href={l.url}>{l.label} ↗</a></li>)}
        </ul>
      </div>
    </aside>
  </div>
</Base>
