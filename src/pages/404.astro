---
import Base from '../layouts/Base.astro';
---
<Base title="Not found" description="This page does not exist.">
  <section class="wrap narrow entry-head" style="padding-bottom:5rem">
    <p class="eyebrow">404</p>
    <h1>Nothing here</h1>
    <p class="lede">The page may have moved when the site was rebuilt. Everything is reachable from these:</p>
    <div class="btn-row">
      <a class="btn primary" href="/work/">Work</a>
      <a class="btn" href="/experience/">Experience</a>
      <a class="btn" href="/search/">Search</a>
      <a class="btn" href="/">Home</a>
    </div>
  </section>
</Base>
