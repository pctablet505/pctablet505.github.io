---
// One number with what it measures and where it comes from: a checked number links its public source; a reported
// number says who reported it.
import type { Num } from '../lib/profile';
import { fmtDate } from '../lib/site';

interface Props {
  num: Num;
  href?: string;
  context?: string;
}
const { num, href, context } = Astro.props;
const from = num.source === 'owner' ? 'my account' : `my ${num.source}`;
---
<div class="num">
  <div class="stat-value">{num.value}</div>
  <div class="stat-what">{num.what}{context && <span class="muted"> · {context}</span>}</div>
  {num.status === 'checked' ? (
    <a class="stat-src" href={num.source} title="Re-read at this public source"><span class="ok">●</span> checked {fmtDate(num.as_of)} · source</a>
  ) : (
    <span class="stat-src" title="No public source to check; reported by me">○ reported, from {from}</span>
  )}
  {href && <a class="stat-src" href={href}>details →</a>}
</div>
