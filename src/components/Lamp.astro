---
// The brand mark: a cord and a lit bulb. Colours come from the theme.
interface Props {
  class?: string;
}
const { class: cls } = Astro.props;
---
<svg class={cls} viewBox="0 0 64 64" aria-hidden="true" focusable="false">
  <path d="M32 0V18" stroke="currentColor" stroke-width="5" />
  <rect x="25" y="16" width="14" height="9.5" rx="2.5" fill="currentColor" />
  <circle cx="32" cy="42.5" r="15.75" fill="var(--bulb)" stroke="var(--bulb-rim)" stroke-width="2.5" />
</svg>
