---
// Illustration drawn by code. A face's landmarks are generated from simple curves (jaw, brows, eyes, nose, mouth),
// not taken from any photo. "attention" turns the head away and back while an attention meter follows; "recognition"
// finds several faces in a frame and walks a tree index instead of scanning every stored face.
import { face, line } from '../lib/faces';

interface Props {
  variant?: 'attention' | 'recognition';
  big?: boolean;
}
const { variant = 'attention', big = false } = Astro.props;
const main = face(170, 128, 1.25);
const people = [
  { cx: 92, cy: 120, s: 0.72, tag: 'known' },
  { cx: 214, cy: 112, s: 0.82, tag: 'known' },
  { cx: 330, cy: 126, s: 0.66, tag: 'new face' },
].map((p) => ({ ...p, f: face(p.cx, p.cy, p.s) }));
const tree: { x: number; y: number; px?: number; py?: number; on: boolean }[] = [];
(function grow(x: number, y: number, depth: number, spread: number, on: boolean, px?: number, py?: number) {
  tree.push({ x, y, px, py, on });
  if (depth === 3) return;
  grow(x - spread, y + 34, depth + 1, spread / 2, on && depth % 2 === 0, x, y);
  grow(x + spread, y + 34, depth + 1, spread / 2, on && depth % 2 === 1, x, y);
})(424, 52, 0, 28, true);
---
{variant === 'attention' ? (
  <svg viewBox="0 0 480 270" role="img" aria-label="Illustration: face landmarks and head pose. As the head turns away the attention meter drops; as it turns back it rises." class:list={['fl', 'att', { big }]}>
    <g class="head">
      {main.groups.map((g, i) => <path d={line(g, i === 3 || i === 4 || i === 7)} fill="none" stroke="var(--line-2)" stroke-width="1.2" />)}
      {main.groups.flat().map(([x, y]) => <circle cx={x} cy={y} r="2.2" fill="var(--vision)" />)}
      <g class="axes" stroke-width="2.5" stroke-linecap="round">
        <line x1={main.nose[0]} y1={main.nose[1]} x2={main.nose[0] + 40} y2={main.nose[1]} stroke="#ef4444" />
        <line x1={main.nose[0]} y1={main.nose[1]} x2={main.nose[0]} y2={main.nose[1] - 40} stroke="#22c55e" />
        <line class="gaze" x1={main.nose[0]} y1={main.nose[1]} x2={main.nose[0] - 18} y2={main.nose[1] + 22} stroke="#3b82f6" />
      </g>
    </g>
    <g font-family="var(--font-mono)">
      <text x="330" y="70" class="k">head pose</text>
      <text x="330" y="90" class="v yaw0">yaw  0°</text>
      <text x="330" y="90" class="v yaw1">yaw 38°</text>
      <text x="330" y="132" class="k">attention</text>
      <rect x="330" y="142" width="120" height="12" rx="6" fill="var(--surface)" stroke="var(--line-2)" />
      <rect class="meter" x="330" y="142" width="120" height="12" rx="6" fill="var(--vision)" />
      <text x="330" y="182" class="v st0">attentive</text>
      <text x="330" y="182" class="v st1">looking away</text>
    </g>
  </svg>
) : (
  <svg viewBox="0 0 480 270" role="img" aria-label="Illustration: three faces found in one camera frame, each matched by walking a tree index from its root instead of comparing against every stored face." class:list={['fl', 'rec', { big }]}>
    <rect x="24" y="32" width="352" height="200" rx="12" fill="var(--surface)" stroke="var(--line-2)" />
    <rect class="scan" x="24" y="32" width="6" height="200" fill="var(--vision)" opacity="0.35" />
    {people.map((p, k) => (
      <g class={`person p${k}`}>
        {p.f.groups.map((g, i) => <path d={line(g, i === 3 || i === 4 || i === 7)} fill="none" stroke="var(--line-2)" stroke-width="1" />)}
        {p.f.groups.flat().map(([x, y]) => <circle cx={x} cy={y} r="1.6" fill="var(--vision)" />)}
        <rect class="box" x={p.cx - 62 * p.s} y={p.cy - 52 * p.s} width={124 * p.s} height={128 * p.s} rx="6" fill="none" stroke="var(--vision)" stroke-width="2" />
        <text x={p.cx} y={p.cy + 92 * p.s} text-anchor="middle" class="tag">{p.tag}</text>
      </g>
    ))}
    <text x="424" y="30" text-anchor="middle" class="k">index</text>
    {tree.filter((n) => n.px !== undefined).map((n) => (
      <line x1={n.px} y1={n.py} x2={n.x} y2={n.y} stroke={n.on ? 'var(--vision)' : 'var(--line-2)'} stroke-width={n.on ? 2.5 : 1.2} class={n.on ? 'path-on' : ''} />
    ))}
    {tree.map((n) => <circle cx={n.x} cy={n.y} r="5" fill={n.on ? 'var(--vision)' : 'var(--surface)'} stroke={n.on ? 'var(--vision)' : 'var(--line-2)'} />)}
    <text x="424" y="200" text-anchor="middle" class="k">few steps,</text>
    <text x="424" y="216" text-anchor="middle" class="k">not every face</text>
  </svg>
)}

<style>
  .k {
    font: 500 12px var(--font-mono);
    fill: var(--ink-3);
  }
  .v {
    font: 650 15px var(--font-mono);
    fill: var(--ink);
  }
  .tag {
    font: 600 11px var(--font-mono);
    fill: var(--vision);
  }
  .head {
    transform-origin: 170px 128px;
    animation: fl-turn 7s ease-in-out infinite;
  }
  .meter {
    transform-origin: 330px 148px;
    animation: fl-meter 7s ease-in-out infinite;
  }
  .yaw1,
  .st1 {
    opacity: 0;
    animation: fl-on 7s ease-in-out infinite;
  }
  .yaw0,
  .st0 {
    animation: fl-off 7s ease-in-out infinite;
  }
  @keyframes fl-turn {
    0%, 20%, 80%, 100% { transform: none; }
    40%, 60% { transform: translateX(-16px) scaleX(0.82) skewY(3deg); }
  }
  @keyframes fl-meter {
    0%, 20%, 80%, 100% { transform: scaleX(1); }
    40%, 60% { transform: scaleX(0.18); }
  }
  @keyframes fl-on {
    0%, 30% { opacity: 0; }
    38%, 64% { opacity: 1; }
    72%, 100% { opacity: 0; }
  }
  @keyframes fl-off {
    0%, 30% { opacity: 1; }
    38%, 64% { opacity: 0; }
    72%, 100% { opacity: 1; }
  }
  .scan {
    animation: fl-scan 5s linear infinite;
  }
  .box {
    opacity: 0;
    animation: fl-box 5s ease-out infinite;
  }
  .p1 .box { animation-delay: 0.6s; }
  .p2 .box { animation-delay: 1.2s; }
  .path-on {
    stroke-dasharray: 60;
    stroke-dashoffset: 60;
    animation: fl-walk 5s ease-in-out infinite 1.6s;
  }
  @keyframes fl-scan {
    0% { transform: translateX(0); }
    60%, 100% { transform: translateX(346px); opacity: 0; }
  }
  @keyframes fl-box {
    0%, 20% { opacity: 0; }
    30%, 85% { opacity: 1; }
    100% { opacity: 0; }
  }
  @keyframes fl-walk {
    0% { stroke-dashoffset: 60; }
    30%, 85% { stroke-dashoffset: 0; }
    100% { stroke-dashoffset: 60; }
  }
  @media (prefers-reduced-motion: reduce) {
    .head, .meter, .yaw0, .yaw1, .st0, .st1, .scan, .box, .path-on { animation: none; }
    .box { opacity: 1; }
    .path-on { stroke-dashoffset: 0; }
  }
</style>
