---
// Drawn from data: the bars are the chart values in PROFILE.md, which are the repository's own measurements.
import type { Chart } from '../lib/profile';
interface Props {
  chart: Chart;
  big?: boolean;
}
const { chart, big = false } = Astro.props;
const bars = chart.bars!;
const max = Math.max(...bars.map((b) => b.value)) * 1.08;
const LX = 196;
const RX = 452;
const top = 30;
const step = (240 - top) / bars.length;
const bw = (v: number) => ((RX - LX) * v) / max;
---
<svg viewBox="0 0 480 270" role="img" aria-label={`${chart.title}: ${bars.map((b) => `${b.label} ${b.value}`).join('; ')}.`} class:list={['dc', { big }]}>
  <defs>
    <pattern id="dc-hatch" width="6" height="6" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
      <rect width="6" height="6" fill="var(--surface)" />
      <line x1="0" y1="0" x2="0" y2="6" stroke="var(--ink-3)" stroke-width="2" />
    </pattern>
  </defs>
  <text x="24" y="20" class="t">{chart.title}</text>
  {bars.map((b, i) => {
    const y = top + i * step + 8;
    const h = step - 16;
    return (
      <g class="row" style={`--d:${i * 0.12}s`}>
        <text x={LX - 10} y={y + h / 2 + 4} text-anchor="end" class:list={['lbl', { off: b.off }]}>{b.label}</text>
        <rect class="bar" x={LX} y={y} width={bw(b.value)} height={h} rx="4" fill={b.off ? 'url(#dc-hatch)' : i === bars.length - 2 ? 'var(--performance)' : 'var(--ink-3)'} opacity={b.off ? 0.7 : 1} />
        <text x={LX + bw(b.value) + 6} y={y + h / 2 + 4} class:list={['val', { off: b.off }]}>{b.value.toFixed(2)}</text>
      </g>
    );
  })}
</svg>

<style>
  .t {
    font: 600 12px var(--font-sans);
    fill: var(--ink-2);
  }
  .lbl {
    font: 500 11.5px var(--font-sans);
    fill: var(--ink-2);
  }
  .val {
    font: 650 12px var(--font-mono);
    fill: var(--ink);
  }
  .off {
    fill: var(--ink-3);
  }
  .bar {
    transform-box: fill-box;
    transform-origin: left center;
    animation: dc-grow 1.1s cubic-bezier(0.2, 0.7, 0.2, 1) both;
    animation-delay: var(--d);
  }
  @keyframes dc-grow {
    from { transform: scaleX(0); }
    to { transform: scaleX(1); }
  }
  @media (prefers-reduced-motion: reduce) {
    .bar { animation: none; }
  }
</style>
