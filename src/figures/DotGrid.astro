---
// Drawn from data: one dot per tier, filled from a value such as "69 of 70" in PROFILE.md.
interface Props {
  value: string;
  yes: string;
  no: string;
  big?: boolean;
}
const { value, yes, no, big = false } = Astro.props;
const m = value.match(/(\d+)\s+of\s+(\d+)/);
if (!m) throw new Error(`DotGrid: cannot read "${value}"`);
const hit = Number(m[1]);
const total = Number(m[2]);
const cols = 10;
const rows = Math.ceil(total / cols);
const gap = 30;
const x0 = 240 - ((cols - 1) * gap) / 2;
const y0 = 46;
---
<svg viewBox="0 0 480 270" role="img" aria-label={`${hit} of ${total}: ${yes}.`} class:list={['dg', { big }]}>
  {Array.from({ length: total }, (_, i) => (
    <circle cx={x0 + (i % cols) * gap} cy={y0 + Math.floor(i / cols) * 26} r="9" fill={i < hit ? 'var(--projects)' : 'var(--bulb)'} style={`--d:${(i * 0.025).toFixed(3)}s`} />
  ))}
  <g font-family="var(--font-sans)" font-size="12">
    <circle cx="70" cy={y0 + rows * 26 + 14} r="6" fill="var(--projects)" />
    <text x="82" y={y0 + rows * 26 + 18} fill="var(--ink-2)">{hit}: {yes}</text>
    <circle cx="70" cy={y0 + rows * 26 + 34} r="6" fill="var(--bulb)" />
    <text x="82" y={y0 + rows * 26 + 38} fill="var(--ink-2)">{total - hit}: {no}</text>
  </g>
</svg>

<style>
  circle[style] {
    transform-box: fill-box;
    transform-origin: center;
    animation: dg-pop 0.5s cubic-bezier(0.3, 1.4, 0.5, 1) both;
    animation-delay: var(--d);
  }
  @keyframes dg-pop {
    from { transform: scale(0); }
    to { transform: scale(1); }
  }
  @media (prefers-reduced-motion: reduce) {
    circle[style] { animation: none; }
  }
</style>
